# --- Database -------------------------------------------------------------
# SQLite database file (relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Secret used to sign the session cookie. Change this to a long random string.
AUTH_SECRET="change-me"

# --- AI (optional) --------------------------------------------------------
# The app works fully WITHOUT an AI key. AI features (summaries, chat,
# question/flashcard generation) activate only when a key is present.
#
# Get a free key from Google AI Studio (no credit card required):
#   https://aistudio.google.com/apikey
# Leave empty to disable AI features gracefully.
GEMINI_API_KEY=""

# Gemini model to use. gemini-2.0-flash is fast and on the free tier.
GEMINI_MODEL="gemini-2.0-flash"
